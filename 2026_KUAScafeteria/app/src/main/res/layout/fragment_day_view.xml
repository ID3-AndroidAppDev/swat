<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_tertiary">

    <!-- ═══ STICKY HEADER ═══ -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/background_primary"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Campus row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="6dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_campus_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/campus_label"
                    android:textSize="10sp"
                    android:textColor="@color/text_tertiary"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tv_campus_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/campus_uzumasa"
                    android:textSize="17sp"
                    android:textColor="@color/text_primary" />

                <LinearLayout
                    android:id="@+id/status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_status_badge"
                    android:paddingStart="8dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:visibility="gone">

                    <View
                        android:id="@+id/status_dot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_status_dot" />

                    <TextView
                        android:id="@+id/tv_open_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.01" />
                </LinearLayout>
            </LinearLayout>

            <!-- Campus switcher -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_campus_switch"
                android:padding="3dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/btn_campus_uzumasa"
                    android:layout_width="56dp"
                    android:layout_height="match_parent"
                    android:text="Uzumasa"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:textColor="@color/text_secondary"
                    android:background="@drawable/selector_campus_button" />

                <TextView
                    android:id="@+id/btn_campus_kameoka"
                    android:layout_width="56dp"
                    android:layout_height="match_parent"
                    android:text="Kameoka"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:textColor="@color/text_secondary"
                    android:background="@drawable/selector_campus_button" />
            </LinearLayout>

            <!-- Filter allergens toggle -->
            <ImageButton
                android:id="@+id/btn_filter_allergens"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_filter"
                android:background="@drawable/bg_icon_button"
                android:padding="5dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/filter_allergens"
                android:visibility="visible" />

            <!-- Settings button -->
            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_settings"
                android:background="@drawable/bg_icon_button"
                android:padding="4dp"
                android:contentDescription="@string/settings" />
        </LinearLayout>

        <!-- Week navigation -->
        <LinearLayout
            android:id="@+id/week_nav_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btn_prev_week"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_chevron_left"
                android:background="@drawable/bg_week_arrow"
                android:padding="2dp"
                android:contentDescription="@string/prev_week" />

            <TextView
                android:id="@+id/tv_week_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Jun 1 – 5"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />

            <ImageButton
                android:id="@+id/btn_next_week"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_chevron_right"
                android:background="@drawable/bg_week_arrow"
                android:padding="2dp"
                android:contentDescription="@string/next_week" />
        </LinearLayout>

        <!-- Day pills strip — 5 equal-weight items inflated at runtime -->
        <LinearLayout
            android:id="@+id/day_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp" />

        <!-- Header divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_tertiary" />
    </LinearLayout>

    <!-- ═══ OFFLINE BANNER ═══ -->
    <TextView
        android:id="@+id/tv_offline_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:gravity="center"
        android:text="@string/offline_banner"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:background="@color/background_secondary"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══ SCROLLABLE CONTENT ═══ -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tv_offline_banner"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/content_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Loading skeleton -->
                <LinearLayout
                    android:id="@+id/view_loading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <View android:layout_width="match_parent" android:layout_height="72dp"
                        android:background="@drawable/bg_skeleton"
                        android:layout_marginBottom="10dp" />
                    <View android:layout_width="match_parent" android:layout_height="72dp"
                        android:background="@drawable/bg_skeleton"
                        android:layout_marginBottom="10dp" />
                    <View android:layout_width="match_parent" android:layout_height="72dp"
                        android:background="@drawable/bg_skeleton"
                        android:layout_marginBottom="10dp" />
                    <View android:layout_width="match_parent" android:layout_height="72dp"
                        android:background="@drawable/bg_skeleton" />
                </LinearLayout>

                <!-- Empty state -->
                <LinearLayout
                    android:id="@+id/view_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="64dp"
                    android:paddingBottom="64dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_calendar_off"
                        android:alpha="0.4" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/no_menu_for_day"
                        android:textSize="15sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <!-- Error state -->
                <LinearLayout
                    android:id="@+id/view_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="64dp"
                    android:paddingBottom="64dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/iv_error_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_alert"
                        android:alpha="0.4"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/tv_error_msg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/error_load_menu"
                        android:textSize="15sp"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tv_error_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:paddingStart="32dp"
                        android:paddingEnd="32dp"
                        android:textSize="13sp"
                        android:textColor="@color/text_tertiary"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_retry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/retry"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <!-- Closed state (holiday / not open) -->
                <LinearLayout
                    android:id="@+id/view_closed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="64dp"
                    android:paddingBottom="64dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_calendar_off"
                        android:alpha="0.4" />

                    <TextView
                        android:id="@+id/tv_closed_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/restaurant_closed"
                        android:textSize="15sp"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tv_closed_reason"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="13sp"
                        android:textColor="@color/text_tertiary"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Menu sections — filled dynamically -->
                <LinearLayout
                    android:id="@+id/sections_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="24dp"
                    android:visibility="gone" />
            </FrameLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- ═══ WEEK GRID (tablet / large landscape) — filled at runtime ═══ -->
    <HorizontalScrollView
        android:id="@+id/week_grid_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tv_offline_banner"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/week_grid"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="12dp" />
    </HorizontalScrollView>

    <!-- ═══ COMPARE BAR (shown when ≥1 dish picked) ═══ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_compare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="@string/compare_button"
        android:textColor="@color/accent_contrast"
        app:backgroundTint="@color/accent"
        app:cornerRadius="24dp"
        app:icon="@drawable/ic_compare"
        app:iconTint="@color/accent_contrast"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
